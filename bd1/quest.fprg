<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="quest (2)"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-27 03:49:58 PM"/>
        <attribute name="created" value="dXNlcjtQQzsyMDI2LTEwLTI3IDA1OjAwOjAwIFBNOzEwMDA="/>
        <attribute name="edited" value="dXNlcjtQQzsyMDI2LTEwLTI3IDA1OjAwOjAwIFBNOzEwMDA="/>
        <attribute name="edited" value="dXNlcjtXSU4tSjNMU09NOFQ2TlE7MjAyNi0xMC0yNzswMzo0OTo1OCBQTTszOzI5MjY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i, sum, erembe, niit, shildegonoo1, shildegonoo2, shildegonoo3, max" type="Integer" array="False" size=""/>
            <declare name="ner, shildegner1, shildegner2, shildegner3" type="String" array="False" size=""/>
            <do expression="n &lt; 3 || n &gt; 10">
                <input variable="n"/>
            </do>
            <assign variable="shildegonoo1" expression="-1"/>
            <assign variable="shildegonoo2" expression="-1"/>
            <assign variable="shildegonoo3" expression="-1"/>
            <assign variable="shildegner1" expression="&quot;-&quot;"/>
            <assign variable="shildegner2" expression="&quot;-&quot;"/>
            <assign variable="shildegner3" expression="&quot;-&quot;"/>
            <for variable="i" start="1" end="n " direction="inc" step="1">
                <input variable="ner"/>
                <assign variable="niit" expression="0"/>
                <for variable="sum" start="1" end="4" direction="inc" step="1">
                    <do expression="max &lt; 0 || max &gt; 10">
                        <input variable="max"/>
                    </do>
                    <assign variable="niit" expression="niit + max"/>
                </for>
                <call expression="angilal(niit)"/>
                <if expression="niit &gt; shildegonoo1">
                    <then>
                        <assign variable="shildegonoo3" expression="shildegonoo2"/>
                        <assign variable="shildegner3" expression="shildegner2"/>
                        <assign variable="shildegonoo2" expression="shildegonoo1"/>
                        <assign variable="shildegner2" expression="shildegner1"/>
                        <assign variable="shildegonoo1" expression="niit"/>
                        <assign variable="shildegner1" expression="ner"/>
                    </then>
                    <else>
                        <if expression="niit &gt; shildegonoo2">
                            <then>
                                <assign variable="shildegonoo3" expression="shildegonoo2"/>
                                <assign variable="shildegner3" expression="shildegner2"/>
                                <assign variable="shildegonoo2" expression="niit"/>
                                <assign variable="shildegner2" expression="ner"/>
                            </then>
                            <else>
                                <if expression="niit &gt; shildegonoo3">
                                    <then>
                                        <assign variable="shildegonoo3" expression="niit"/>
                                        <assign variable="shildegner3" expression="ner"/>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="shildegner1 &amp; &quot; &quot; &amp; shildegonoo1" newline="True"/>
            <output expression="shildegner2 &amp; &quot; &quot; &amp; shildegonoo2" newline="True"/>
            <output expression="shildegner3 &amp; &quot; &quot; &amp; shildegonoo3" newline="True"/>
        </body>
    </function>
    <function name="angilal" type="None" variable="">
        <parameters>
            <parameter name="niit" type="Integer" array="False"/>
        </parameters>
        <body>
            <if expression="niit = 40">
                <then>
                    <output expression="&quot;mash sain&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="niit &gt;= 30">
                        <then>
                            <output expression="&quot;sain&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="niit &gt;= 20">
                                <then>
                                    <output expression="&quot;dund&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;muu&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
